# Copy to .env for local development. Never commit .env.

# Required. Any long random string locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Optional locally. Without these the site uses sample events, Cloudflare's always-pass
# Turnstile test keys, and logs emails to the console instead of sending them.
GOOGLE_CALENDAR_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="Montague Common Hall <website@mail.montaguecommonhall.org>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to false to run a production build against the local database (no Cloudflare account).
# CLOUDFLARE_REMOTE_BINDINGS=false
